rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    match /scans/{scanId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Existing waitlist functionality.
    // Keep this unchanged for now.
    match /waitlist_leads/{leadId} {
      allow read, write: if true;
    }

    // User profiles.
    match /users/{uid} {

      // A signed-in user can create only their own profile.
      allow create:
        if request.auth != null
        && request.auth.uid == uid;

      // A signed-in user can read only their own profile.
      allow read:
        if request.auth != null
        && request.auth.uid == uid;

      // A signed-in user can update only their own profile.
      allow update:
        if request.auth != null
        && request.auth.uid == uid;

      // A signed-in user can delete only their own profile.
      allow delete:
        if request.auth != null
        && request.auth.uid == uid;
    }
  }
}
