{
  "name": "truthscan-ai",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "lint": "npm --workspace frontend run lint",
    "typecheck": "npm --workspace frontend run lint",
    "test": "npm --workspace frontend run test",
    "preview": "npm --workspace frontend run preview",
    "backend:install": "npm --prefix backend/functions install",
    "backend:build": "npm --prefix backend/functions run build",
    "verify": "npm test && npm run typecheck && npm run build && npm run backend:build"
  }
}
