        }
        lines {
          text: "  RefreshCw, FileText, Share2, History, Database, Camera, Layers, Gauge"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "} from \'lucide-react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// Predefined samples for immersive interactive vision simulations"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "const PRESETS = ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: \'sample-genuine\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    brand: \'AuraLuxe Labs\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
