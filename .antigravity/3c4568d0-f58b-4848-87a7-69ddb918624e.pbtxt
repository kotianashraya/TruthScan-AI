          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Upload, Sparkles, CheckCircle2, AlertTriangle, XCircle, "
